{
  "name": "api-chassis",
  "version": "0.1.0",
  "description": "API boilerplate that bundles a lot of stuff: file-system service registration, hooks, validation, micro-service clients, caching, queues and sockets.",
  "license": "MIT",
  "author": "Harkarman Singh",
  "keywords": [
    "express",
    "api",
    "boilerplate",
    "rest",
    "services"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.21.0",
    "bullmq": "^6.5.1",
    "express-winston": "^4.2.0",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <2.0.0 || >=1.0.0-rc.1 <1.0.0",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
